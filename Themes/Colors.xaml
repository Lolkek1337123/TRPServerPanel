<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- [WINDOW BACKGROUND] — TRP SERVER PANEL Radial Glows -->
    <Color x:Key="BackgroundColor">#050505</Color>
    <Color x:Key="SecondaryBackgroundColor">#0A0A0A</Color>
    <Color x:Key="CardBackgroundColor">#111111</Color>
    
    <!-- Accent Colors (TRP SERVER PANEL) -->
    <Color x:Key="PrimaryPulseColor">#FF0000</Color>
    <Color x:Key="SecondaryPulseColor">#E60000</Color>
    <Color x:Key="HighlightColor">#FF3333</Color>
    <Color x:Key="GlowColor">#80FF0000</Color>

    <!-- Text Colors -->
    <Color x:Key="TextPrimaryColor">#FFFFFF</Color>
    <Color x:Key="TextSecondaryColor">#A0A0A0</Color>
    <Color x:Key="TextMutedColor">#666666</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="SecondaryBackgroundBrush" Color="{StaticResource SecondaryBackgroundColor}"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackgroundColor}"/>
    
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryPulseColor}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>

    <!-- UI Elements -->
    <SolidColorBrush x:Key="GlassBorderBrush" Color="{StaticResource PrimaryPulseColor}" Opacity="0.15"/>
    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="{StaticResource SecondaryBackgroundColor}" Opacity="0.95"/>

</ResourceDictionary>
