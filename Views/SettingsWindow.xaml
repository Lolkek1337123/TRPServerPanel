<Window x:Class="TRPServerPanel.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TRP SERVER PANEL" Height="750" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1" CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="70"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="#0A0A0A" CornerRadius="12,12,0,0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="20,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⚙" Foreground="{StaticResource PrimaryBrush}" FontSize="18" Margin="0,0,10,0"/>
                        <TextBlock Text="{DynamicResource Str_Settings}" Foreground="White" FontWeight="Black" FontSize="14" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Content="✕" HorizontalAlignment="Right" Foreground="#404040" Background="Transparent" BorderThickness="0" Click="Close_Click" FontSize="16"/>
                </Grid>
            </Border>

            <!-- Content Area with Tabs -->
            <Grid Grid.Row="1" Margin="20,10">
                <TabControl SelectedIndex="{Binding SelectedSettingsTabIndex}" Background="Transparent" BorderThickness="0">
                    <TabControl.Resources>
                        <Style TargetType="TabItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TabItem">
                                        <Border x:Name="Border" Background="Transparent" BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="15,8" Margin="0,0,10,10">
                                            <ContentPresenter x:Name="ContentSite" ContentSource="Header" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                                <Setter Property="TextElement.Foreground" Value="White"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="#0DFFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Foreground" Value="#606060"/>
                            <Setter Property="FontSize" Value="11"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </Style>
                    </TabControl.Resources>

                    <!-- GENERAL / NETWORK -->
                    <TabItem Header="SERVER / NETWORK">
                        <ScrollViewer Padding="0,15,10,0">
                            <StackPanel>
                                <HeaderedContentControl Header="IDENTITY" Style="{StaticResource SettingGroupStyle}">
                                    <StackPanel>
                                        <HeaderedContentControl Header="SERVER NAME" Style="{StaticResource SettingFieldStyle}">
                                            <TextBox Text="[RU/EN] TRP SERVER PANEL | MAX POOL" Style="{StaticResource PlaceholderTextBoxStyle}" Foreground="White"/>
                                        </HeaderedContentControl>
                                        <HeaderedContentControl Header="IDENTIFIER (FOLDER)" Style="{StaticResource SettingFieldStyle}">
                                            <TextBox Text="server_instance_01" Style="{StaticResource PlaceholderTextBoxStyle}" Foreground="White"/>
                                        </HeaderedContentControl>
                                    </StackPanel>
                                </HeaderedContentControl>
                                
                                <HeaderedContentControl Header="NETWORK CONFIG" Style="{StaticResource SettingGroupStyle}">
                                    <StackPanel>
                                        <UniformGrid Columns="2">
                                            <HeaderedContentControl Header="SERVER IP" Style="{StaticResource SettingFieldStyle}" Margin="0,0,10,15">
                                                <TextBox Text="0.0.0.0" Style="{StaticResource PlaceholderTextBoxStyle}" Foreground="White"/>
                                            </HeaderedContentControl>
                                            <HeaderedContentControl Header="SERVER PORT" Style="{StaticResource SettingFieldStyle}">
                                                <TextBox Text="28015" Style="{StaticResource PlaceholderTextBoxStyle}" Foreground="White"/>
                                            </HeaderedContentControl>
                                            <HeaderedContentControl Header="QUERY PORT" Style="{StaticResource SettingFieldStyle}" Margin="0,0,10,15">
                                                <TextBox Text="28016" Style="{StaticResource PlaceholderTextBoxStyle}" Foreground="White"/>
                                            </HeaderedContentControl>
                                            <HeaderedContentControl Header="RCON PORT" Style="{StaticResource SettingFieldStyle}">
                                                <TextBox Text="28017" Style="{StaticResource PlaceholderTextBoxStyle}" Foreground="White"/>
                                            </HeaderedContentControl>
                                        </UniformGrid>
                                        <HeaderedContentControl Header="RCON PASSWORD" Style="{StaticResource SettingFieldStyle}">
                                            <PasswordBox Background="Transparent" BorderThickness="0" Foreground="White" VerticalContentAlignment="Center"/>
                                        </HeaderedContentControl>
                                    </StackPanel>
                                </HeaderedContentControl>

                                <HeaderedContentControl Header="CAPACITY" Style="{StaticResource SettingGroupStyle}">
                                    <UniformGrid Columns="2">
                                        <HeaderedContentControl Header="MAX PLAYERS" Style="{StaticResource SettingFieldStyle}" Margin="0,0,10,15">
                                            <TextBox Text="200" Style="{StaticResource PlaceholderTextBoxStyle}" Foreground="White"/>
                                        </HeaderedContentControl>
                                        <HeaderedContentControl Header="SERVER TICKRATE" Style="{StaticResource SettingFieldStyle}">
                                            <TextBox Text="30" Style="{StaticResource PlaceholderTextBoxStyle}" Foreground="White"/>
                                        </HeaderedContentControl>
                                    </UniformGrid>
                                </HeaderedContentControl>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- WORLD SETTINGS -->
                    <TabItem Header="WORLD / MAP">
                        <ScrollViewer Padding="0,15,10,0">
                            <StackPanel>
                                <HeaderedContentControl Header="GENERATION" Style="{StaticResource SettingGroupStyle}">
                                    <UniformGrid Columns="2">
                                        <HeaderedContentControl Header="WORLD SEED" Style="{StaticResource SettingFieldStyle}" Margin="0,0,10,15">
                                            <TextBox Text="123456789" Style="{StaticResource PlaceholderTextBoxStyle}" Foreground="White"/>
                                        </HeaderedContentControl>
                                        <HeaderedContentControl Header="WORLD SIZE" Style="{StaticResource SettingFieldStyle}">
                                            <TextBox Text="4000" Style="{StaticResource PlaceholderTextBoxStyle}" Foreground="White"/>
                                        </HeaderedContentControl>
                                        <HeaderedContentControl Header="WORLD SALT" Style="{StaticResource SettingFieldStyle}" Margin="0,0,10,15">
                                            <TextBox Text="0" Style="{StaticResource PlaceholderTextBoxStyle}" Foreground="White"/>
                                        </HeaderedContentControl>
                                        <HeaderedContentControl Header="MAP LEVEL" Style="{StaticResource SettingFieldStyle}">
                                            <TextBox Text="Procedural Map" Style="{StaticResource PlaceholderTextBoxStyle}" Foreground="White"/>
                                        </HeaderedContentControl>
                                    </UniformGrid>
                                </HeaderedContentControl>
                                
                                <HeaderedContentControl Header="ENVIRONMENT" Style="{StaticResource SettingGroupStyle}">
                                    <StackPanel>
                                        <HeaderedContentControl Header="TIME OF DAY" Style="{StaticResource SettingFieldStyle}">
                                            <TextBox Text="12.0" Style="{StaticResource PlaceholderTextBoxStyle}" Foreground="White"/>
                                        </HeaderedContentControl>
                                        <CheckBox Content="FREEZE TIME" Foreground="White" Margin="0,10,0,5"/>
                                        <CheckBox Content="CUSTOM RADIATION" Foreground="White" Margin="0,0,0,5"/>
                                    </StackPanel>
                                </HeaderedContentControl>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- BRANDING -->
                    <TabItem Header="BRANDING / MEDIA">
                        <ScrollViewer Padding="0,15,10,0">
                            <StackPanel>
                                <HeaderedContentControl Header="EXPOSURE" Style="{StaticResource SettingGroupStyle}">
                                    <StackPanel>
                                        <HeaderedContentControl Header="SERVER DESCRIPTION" Style="{StaticResource SettingFieldStyle}">
                                            <TextBox Text="Welcome to TRP SERVER PANEL server!" Style="{StaticResource PlaceholderTextBoxStyle}" Foreground="White" AcceptsReturn="True" Height="80" TextWrapping="Wrap"/>
                                        </HeaderedContentControl>
                                        <HeaderedContentControl Header="SERVER URL" Style="{StaticResource SettingFieldStyle}">
                                            <TextBox Text="https://trp-panel.net" Style="{StaticResource PlaceholderTextBoxStyle}" Foreground="White"/>
                                        </HeaderedContentControl>
                                        <HeaderedContentControl Header="HEADER IMAGE (1024x512)" Style="{StaticResource SettingFieldStyle}">
                                            <TextBox Text="https://img.cdn/banner.jpg" Style="{StaticResource PlaceholderTextBoxStyle}" Foreground="White"/>
                                        </HeaderedContentControl>
                                    </StackPanel>
                                </HeaderedContentControl>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <!-- APPLICATION SETTINGS -->
                    <TabItem Header="{DynamicResource Str_AppSettings}">
                        <ScrollViewer Padding="0,15,10,0">
                            <StackPanel>
                                <HeaderedContentControl Header="GENERAL SYSTEM" Style="{StaticResource SettingGroupStyle}">
                                    <StackPanel>
                                        <HeaderedContentControl Header="{DynamicResource Str_AppLanguage}" Style="{StaticResource SettingFieldStyle}">
                                            <ComboBox SelectedIndex="0" Background="#151515" BorderThickness="0" Foreground="White" Padding="10,5">
                                                <ComboBoxItem Content="Русский (RU)"/>
                                                <ComboBoxItem Content="English (EN)"/>
                                            </ComboBox>
                                        </HeaderedContentControl>
                                        <CheckBox Content="{DynamicResource Str_AutoStart}" Foreground="White" Margin="0,15,0,5" IsChecked="True"/>
                                        <CheckBox Content="{DynamicResource Str_MinimizeToTray}" Foreground="White" Margin="0,5,0,5"/>
                                    </StackPanel>
                                </HeaderedContentControl>
                                
                                <HeaderedContentControl Header="STORAGE &amp; CACHE" Style="{StaticResource SettingGroupStyle}">
                                    <HeaderedContentControl Header="{DynamicResource Str_SteamPath}" Style="{StaticResource SettingFieldStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="C:\TRP_Panel\Cache\SteamCMD" Style="{StaticResource PlaceholderTextBoxStyle}" Foreground="White" IsReadOnly="True"/>
                                            <Button Grid.Column="1" Content="..." Width="30" Margin="5,0,0,0" Style="{StaticResource AntigravityButtonStyle}"/>
                                        </Grid>
                                    </HeaderedContentControl>
                                </HeaderedContentControl>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- PERSONALIZATION -->
                    <TabItem Header="{DynamicResource Str_Personalization}">
                        <ScrollViewer Padding="0,15,10,0">
                            <StackPanel>
                                <HeaderedContentControl Header="{DynamicResource Str_ThemeSettings}" Style="{StaticResource SettingGroupStyle}">
                                    <StackPanel>
                                        <HeaderedContentControl Header="{DynamicResource Str_AccentColor}" Style="{StaticResource SettingFieldStyle}">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="30" Height="30" Background="#FF0000" CornerRadius="15" Margin="0,0,10,0" BorderBrush="White" BorderThickness="2"/>
                                                <Border Width="30" Height="30" Background="#007ACC" CornerRadius="15" Margin="0,0,10,0"/>
                                                <Border Width="30" Height="30" Background="#00CC44" CornerRadius="15" Margin="0,0,10,0"/>
                                            </StackPanel>
                                        </HeaderedContentControl>
                                        
                                        <HeaderedContentControl Header="{DynamicResource Str_BlurIntensity}" Style="{StaticResource SettingFieldStyle}">
                                            <DockPanel>
                                                <TextBlock x:Name="percent" Text="80%" Foreground="White" Width="30" VerticalAlignment="Center" Margin="10,0,0,0" DockPanel.Dock="Right"/>
                                                <Slider Minimum="0" Maximum="100" Value="80" TickFrequency="1" IsSnapToTickEnabled="True"/>
                                            </DockPanel>
                                        </HeaderedContentControl>

                                        <HeaderedContentControl Header="{DynamicResource Str_AnimationSpeed}" Style="{StaticResource SettingFieldStyle}">
                                            <ComboBox SelectedIndex="1" Background="#151515" BorderThickness="0" Foreground="White" Padding="10,5">
                                                <ComboBoxItem Content="Fast (0.2s)"/>
                                                <ComboBoxItem Content="Smooth (0.4s)"/>
                                                <ComboBoxItem Content="Cinematic (0.8s)"/>
                                            </ComboBox>
                                        </HeaderedContentControl>
                                    </StackPanel>
                                </HeaderedContentControl>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ABOUT PROGRAM -->
                    <TabItem Header="{DynamicResource Str_About}">
                        <ScrollViewer Padding="0,30,10,30">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="M12,2L4.5,20.29L5.21,21L12,18L18.79,21L19.5,20.29L12,2Z" 
                                      Fill="{StaticResource PrimaryBrush}" Width="64" Height="64" Stretch="Uniform" Margin="0,0,0,20">
                                    <Path.Effect><DropShadowEffect Color="#FF0000" BlurRadius="25" ShadowDepth="0" Opacity="0.8"/></Path.Effect>
                                </Path>
                                
                                <TextBlock Text="TRP SERVER PANEL" Foreground="White" FontSize="24" FontWeight="Black" HorizontalAlignment="Center"/>
                                <TextBlock Text="ORCHESTRATOR HYBRID" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,5,0,30"/>
                                <StackPanel Orientation="Vertical" Margin="0,0,0,20">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBlock Text="BUILD" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Width="80"/>
                                        <TextBlock Text=" : STABLE HYBRID" Foreground="White" FontWeight="Bold" FontSize="10" Margin="5,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                                
                                <TextBlock Text="{DynamicResource Str_TeamInfo}" Foreground="#606060" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                                <TextBlock Text="TEAM RUST PLUGINS // ANTIGRAVITY ENGINE" Foreground="{StaticResource PrimaryBrush}" FontWeight="Black" FontSize="11" HorizontalAlignment="Center" Margin="0,0,0,40"/>
                                
                                <UniformGrid Columns="2" Width="300">
                                    <Button Style="{StaticResource AntigravityButtonStyle}" Content="{DynamicResource Str_VisitDiscord}" Margin="5" Padding="10"/>
                                    <Button Style="{StaticResource AntigravityButtonStyle}" Content="{DynamicResource Str_VisitWebsite}" Margin="5" Padding="10"/>
                                </UniformGrid>
                                
                                <TextBlock Text="© 2026 TRP. ALL RIGHTS RESERVED." Foreground="#202020" FontSize="8" FontWeight="Black" HorizontalAlignment="Center" Margin="0,40,0,0"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- HELP PROGRAM -->
                    <TabItem Header="{DynamicResource Str_Help}">
                        <ScrollViewer Padding="0,20,10,20">
                            <StackPanel>
                                <HeaderedContentControl Header="{DynamicResource Str_HelpGuide}" Style="{StaticResource SettingGroupStyle}">
                                    <TextBlock TextWrapping="Wrap" Foreground="#A0A0A0" FontSize="12" LineHeight="20" Margin="0,5">
                                        <Run Text="{DynamicResource Str_HelpDesc}"/>
                                    </TextBlock>
                                </HeaderedContentControl>
                                
                                <HeaderedContentControl Header="{DynamicResource Str_FaqTitle}" Style="{StaticResource SettingGroupStyle}">
                                    <StackPanel>
                                        <Border BorderBrush="#1A1A1A" BorderThickness="0,0,0,1" Padding="0,10">
                                            <TextBlock Text="{DynamicResource Str_Faq1}" Foreground="White" FontSize="11" FontStyle="Italic"/>
                                        </Border>
                                        <Border BorderBrush="#1A1A1A" BorderThickness="0,0,0,1" Padding="0,10">
                                            <TextBlock Text="{DynamicResource Str_Faq2}" Foreground="White" FontSize="11" FontStyle="Italic"/>
                                        </Border>
                                    </StackPanel>
                                </HeaderedContentControl>
                                
                                <HeaderedContentControl Header="{DynamicResource Str_Community}" Style="{StaticResource SettingGroupStyle}">
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Ellipse Fill="{StaticResource PrimaryBrush}" Width="8" Height="8" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Напишите нам в Discord для получения технической поддержки." Foreground="#606060" FontSize="10" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </HeaderedContentControl>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Grid>

            <!-- Actions -->
            <Border Grid.Row="2" Background="#0A0A0A" CornerRadius="0,0,12,12">
                <Grid Margin="20,0">
                    <TextBlock Text="CONFIG PATH: [TRP_PANEL]/cache/config.json" Foreground="#303030" FontSize="10" VerticalAlignment="Center" FontWeight="Bold"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="{DynamicResource Str_Cancel}" Style="{StaticResource HeaderButtonStyle}" Margin="0,0,15,0" Width="120" Click="Close_Click"/>
                        <Button Content="{DynamicResource Str_ApplyChanges}" Style="{StaticResource AntigravityButtonStyle}" Width="160" Click="Close_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
