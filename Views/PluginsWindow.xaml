<Window x:Class="TRPServerPanel.Views.PluginsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TRPServerPanel.Views"
        mc:Ignorable="d"
        Title="Plugin Manager" Height="550" Width="750"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1" CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="#0A0A0A" CornerRadius="12,12,0,0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="15,0">
                    <TextBlock Text="{DynamicResource Str_Plugins}" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Button Content="✕" HorizontalAlignment="Right" Foreground="White" Background="Transparent" BorderThickness="0" Click="Close_Click"/>
                </Grid>
            </Border>

            <!-- Plugins List (Grid Layout) -->
            <ScrollViewer Grid.Row="1" Margin="10">
                <ItemsControl Margin="10">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#0DFFFFFF" Margin="5" Padding="15" CornerRadius="8" BorderBrush="#15FFFFFF" BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Plugin Info -->
                                    <Grid Grid.Row="0">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="32" Height="32" Background="#20FFFFFF" CornerRadius="6" HorizontalAlignment="Left" Margin="0,0,10,0">
                                                <TextBlock Text="🧩" Foreground="White" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            </Border>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="Black" FontSize="12"/>
                                                <TextBlock Text="{Binding Author}" Foreground="#505050" FontSize="9"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Padding="8,2" Background="{Binding StatusColor}" CornerRadius="10">
                                            <TextBlock Text="{Binding Status}" Foreground="White" FontSize="8" FontWeight="Bold"/>
                                        </Border>
                                    </Grid>

                                    <!-- Description (Mocked) -->
                                    <TextBlock Grid.Row="1" Text="Essential plugin for server management and player utilities." Foreground="#808080" FontSize="10" TextWrapping="Wrap" Margin="0,15"/>

                                    <!-- Actions -->
                                    <Grid Grid.Row="2" Margin="0,5,0,0">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="{DynamicResource Str_PluginSettings}" Style="{StaticResource HeaderButtonStyle}" Margin="0,0,5,0" Width="70" FontSize="9"/>
                                            <Button Content="{DynamicResource Str_PluginReload}" Style="{StaticResource AntigravityButtonStyle}" Width="90" FontSize="9"/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>

                    <ItemsControl.ItemsSource>
                        <x:Array Type="{x:Type local:PluginMock}">
                            <local:PluginMock Name="ImageLibrary" Author="ABSO" Status="Active" StatusColor="#2000FF00"/>
                            <local:PluginMock Name="TeleportationPro" Author="SKY" Status="Active" StatusColor="#2000FF00"/>
                            <local:PluginMock Name="Kits" Author="DEOX" Status="Warning" StatusColor="#20FFA500"/>
                            <local:PluginMock Name="NoEscape" Author="DEV" Status="Active" StatusColor="#2000FF00"/>
                            <local:PluginMock Name="Skins" Author="FUZZY" Status="Active" StatusColor="#2000FF00"/>
                            <local:PluginMock Name="Clans" Author="WOLF" Status="Disabled" StatusColor="#20808080"/>
                        </x:Array>
                    </ItemsControl.ItemsSource>
                </ItemsControl>
            </ScrollViewer>

            <!-- Bottom Info -->
            <Border Grid.Row="2" Background="#0A0A0A" CornerRadius="0,0,12,12">
                <Grid Margin="15,0">
                    <TextBlock Text="6 PLUGINS LOADED" Foreground="#303030" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Button HorizontalAlignment="Right" Content="+ INSTALL NEW" Style="{StaticResource HeaderButtonStyle}" Width="120" FontSize="10"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
