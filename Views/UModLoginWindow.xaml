<Window x:Class="TRPServerPanel.Views.UModLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="uMod Authorization" Width="900" Height="700"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackgroundBrush}"
        Style="{StaticResource AntigravityWindowStyle}"
        BorderThickness="1" BorderBrush="#33FF0000">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <!-- Custom Header Titlebar -->
        <Border Grid.Row="0" Background="#11FFFFFF" BorderThickness="0,0,0,1" BorderBrush="{StaticResource GlassBorderBrush}" MouseDown="Header_MouseDown">
            <Grid>
                <TextBlock Text="АВТОРИЗАЦИЯ UMOD" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="15,0,0,0"/>
                <Button Content="✕" Width="40" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Style="{StaticResource WindowControlCloseButtonStyle}" Click="Close_Click"/>
            </Grid>
        </Border>

        <!-- WebView2 Browser Container -->
        <wv2:WebView2 x:Name="LoginWebView" Grid.Row="1" Margin="5"/>

        <!-- Footer / Controls -->
        <Border Grid.Row="2" Background="#0A0A0A" BorderThickness="0,1,0,0" BorderBrush="{StaticResource GlassBorderBrush}">
            <Grid Margin="15,0">
                <TextBlock x:Name="StatusText" Text="Загрузка страницы входа..." Foreground="#A0A0A0" FontSize="10" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="SaveButton" Content="СОХРАНИТЬ КУКИ И ЗАКРЫТЬ" Style="{StaticResource AntigravityButtonStyle}" FontSize="9" FontWeight="Bold" Height="30" Padding="15,0" Click="Save_Click" Margin="0,0,10,0"/>
                    <Button Content="ОТМЕНА" Style="{StaticResource AntigravityButtonStyle}" FontSize="9" FontWeight="Bold" Height="30" Padding="15,0" Click="Close_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
