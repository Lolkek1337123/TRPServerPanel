<Window x:Class="TRPServerPanel.Views.TRPWebWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="TRP Server Panel"
        Height="920" Width="1600"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        Icon="pack://application:,,,/Resources/app_icon.ico"
        StateChanged="Window_StateChanged">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" GlassFrameThickness="0" CornerRadius="0"
                      ResizeBorderThickness="8" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid">
        <Border Background="{StaticResource BackgroundBrush}" CornerRadius="12"
                BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="#FF0000" BlurRadius="50" ShadowDepth="0" Opacity="0.12"/>
            </Border.Effect>
            <Grid>
                <wv2:WebView2 x:Name="PageBrowser"
                              DefaultBackgroundColor="Transparent"
                              WebMessageReceived="PageBrowser_WebMessageReceived"
                              NavigationStarting="PageBrowser_NavigationStarting"
                              NavigationCompleted="PageBrowser_NavigationCompleted"/>

                <Border x:Name="LoadingOverlay" Background="#0A0A0A" CornerRadius="12"
                        Visibility="Visible" IsHitTestVisible="False">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <ProgressBar Style="{StaticResource AntigravityProgressBarStyle}"
                                     IsIndeterminate="True" Width="240" Height="3"/>
                        <TextBlock Text="LOADING PAGE..." Foreground="White" FontSize="11"
                                   FontWeight="Black" Margin="0,20,0,0"
                                   HorizontalAlignment="Center" Opacity="0.8"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
