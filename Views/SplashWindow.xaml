<Window x:Class="TRPServerPanel.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="TRP Orchestrator" Height="260" Width="440"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        ShowInTaskbar="False"
        Topmost="True">

    <Grid>
        <!-- WebView2 Container for the Animated Splash -->
        <wv2:WebView2 x:Name="SplashBrowser" 
                      DefaultBackgroundColor="Transparent"
                      IsHitTestVisible="False"/>
        
        <!-- Optional: Small WPF Progress indicator in case WebView2 lags during init -->
        <Border VerticalAlignment="Bottom" Margin="0,0,0,40" HorizontalAlignment="Center" x:Name="LocalFallback" Visibility="Collapsed">
            <ProgressBar IsIndeterminate="True" Width="100" Height="2" Foreground="#FF0000" Background="#10FFFFFF" BorderThickness="0"/>
        </Border>
    </Grid>
</Window>
