<Window x:Class="TRPServerPanel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="TRP SERVER PANEL V4.0" Height="960" Width="1700"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        Icon="pack://application:,,,/Resources/app_icon.ico"
        StateChanged="Window_StateChanged">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" GlassFrameThickness="0" CornerRadius="0" ResizeBorderThickness="8" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid">
        <Border x:Name="MainBorder" Background="{StaticResource BackgroundBrush}" CornerRadius="12" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="#FF0000" BlurRadius="50" ShadowDepth="0" Opacity="0.12"/>
            </Border.Effect>

            <Grid>
                <!-- Master Hybrid Interface (Chromium Engine) -->
                <wv2:WebView2 x:Name="MainBrowser" 
                              DefaultBackgroundColor="Transparent"
                              WebMessageReceived="MainBrowser_WebMessageReceived"
                              NavigationStarting="MainBrowser_NavigationStarting"
                              NavigationCompleted="MainBrowser_NavigationCompleted"/>

                <!-- Loading HUD (WPF Native) - Collapsed by default for safe hybrid initialization -->
                <Border x:Name="SystemLoader" Background="#0A0A0A" CornerRadius="12" Visibility="Collapsed" IsHitTestVisible="False">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <ProgressBar Style="{StaticResource AntigravityProgressBarStyle}" IsIndeterminate="True" Width="240" Height="3"/>
                        <TextBlock x:Name="SystemLoaderText" Text="INITIALIZING MASTER HUD..." Foreground="White" FontSize="11" FontWeight="Black" Margin="0,20,0,0" HorizontalAlignment="Center" Opacity="0.8"/>
                        <TextBlock x:Name="SystemLoaderSubText" Text="" Foreground="#FF0000" FontSize="9" FontWeight="Bold" Margin="0,8,0,0" HorizontalAlignment="Center" Opacity="0.6"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
